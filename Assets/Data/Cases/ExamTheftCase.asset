%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b2db5aa833b3c644fbb43260ee333e8d, type: 3}
  m_Name: ExamTheftCase
  m_EditorClassIdentifier: Assembly-CSharp::MobilOfl.Case.CaseDefinition
  caseId: case.exam-theft
  caseTitle: Sinav Sorulari Calindi
  openingBrief: Okulda sinav sorulari calindi. Takim delilleri toplayip gercegi ortaya
    cikarmali.
  evidenceItems:
  - id: evidence.security-log
    title: Guvenlik Oda Kaydi
    description: Guvenlik terminalinde laboratuvar koridorunda gece hareket oldugunu
      gosteren kayit bulundu.
    category: 1
    icon: {fileID: 0}
    isCritical: 1
  - id: evidence.answer-key-note
    title: Cevap Anahtari Notu
    description: Kutuphane masasinda sinav cevaplariyla ilgili el yazili bir not
      bulundu.
    category: 0
    icon: {fileID: 0}
    isCritical: 1
  - id: evidence.library-alibi
    title: Okul Ag Oturum Kaydi
    description: Bilisim kulubundeki okul ag oturum kaydi, supheli duran ogrencinin
      olay saatinde kutuphane bilgisayarinda oturum actigini ve yanlis hedef oldugunu
      gosteriyor.
    category: 1
    icon: {fileID: 0}
    isCritical: 0
  - id: evidence.canteen-receipt
    title: Kantin Fis Tutarsizligi
    description: Kantin kasasindaki fis, calisanin ilk ifadesindeki saat ve urun
      bilgisinin bilerek karistirildigini gosteriyor.
    category: 0
    icon: {fileID: 0}
    isCritical: 0
  - id: evidence.locker-key
    title: Yedek Dolap Anahtari
    description: Ogretmenler odasinda gizlenmis bir yedek dolap anahtari bulundu.
    category: 2
    icon: {fileID: 0}
    isCritical: 0
  - id: evidence.guard-testimony
    title: Guvenlik Ifadesi
    description: Guvenlik gorevlisi gece 22:15'te bilisim kulubu ogrencisini laboratuvar
      koridorunda gordugunu soyledi.
    category: 3
    icon: {fileID: 0}
    isCritical: 1
  - id: evidence.student-testimony
    title: Ogrenci Ifadesi
    description: Bir ogrenci cevap anahtari notunun kutuphanede bilisim kulubu ogrencisinin
      defterinden dustugunu soyledi.
    category: 3
    icon: {fileID: 0}
    isCritical: 1
  - id: evidence.archive-ledger
    title: Arsiv Giris Defteri
    description: Arsiv kanadindaki giris defterinde bilisim kulubu ogrencisinin sinavdan
      bir gun once odaya girdigi goruluyor.
    category: 0
    icon: {fileID: 0}
    isCritical: 1
  - id: evidence.security-drawer-note
    title: Guvenlik Cekmecesi Nobet Notu
    description: Kilitli guvenlik cekmecesindeki not, kamera boslugunun nobet degisimi
      sirasinda olustugunu ve gece hareketinin saklanmadigini dogruluyor.
    category: 0
    icon: {fileID: 0}
    isCritical: 1
  - id: evidence.canteen-testimony
    title: Kantin Ifadesi
    description: Kantin calisani, gece bilisim kulubu ogrencisinin enerji icecegi
      alip laboratuvar koridoruna kostugunu anlatti.
    category: 3
    icon: {fileID: 0}
    isCritical: 0
  suspects:
  - id: suspect.tech-club
    displayName: Bilisim Kulubu Ogrencisi
    summary: Okul sistemine erisimi olan ve guvenlik agini taniyan ogrenci.
    requiredEvidenceIds:
    - evidence.security-log
    - evidence.answer-key-note
    - evidence.library-alibi
    - evidence.canteen-receipt
    - evidence.guard-testimony
    - evidence.student-testimony
    - evidence.archive-ledger
    - evidence.security-drawer-note
    - evidence.canteen-testimony
    - evidence.locker-key
  - id: suspect.teacher-assistant
    displayName: Ogretmen Yardimcisi
    summary: Sinav programina ve soru dolabina erisimi olan personel.
    requiredEvidenceIds:
    - evidence.locker-key
    - evidence.archive-ledger
  - id: suspect.canteen-worker
    displayName: Kantin Calisani
    summary: Okul icinde serbest dolasan ama dogrudan sistem erisimi olmayan calisan.
    requiredEvidenceIds:
    - evidence.locker-key
    - evidence.canteen-testimony
  - id: suspect.library-student
    displayName: Kutuphane Ogrencisi
    summary: Notun bulundugu masaya yakin duran ama oturum kaydi sayesinde olay aninda
      kutuphanede kaldigi anlasilan yanlis hedef.
    requiredEvidenceIds:
    - evidence.answer-key-note
    - evidence.library-alibi
  culpritSuspectId: suspect.tech-club
  culpritMotive: Sinavdan once sorulari satip para kazanmak istedi.
  culpritTimeline: Once kantinden enerji icecegi aldi, sonra laboratuvar koridoruna
    girdi, arsiv kayitlarini kontrol etti ve ogretmenler odasindaki dolabi acmak
    icin yedek anahtari kullandi.
  motiveOptions:
  - Sinavdan once sorulari satip para kazanmak istedi.
  - Arkadasini korumak icin sorulari sakladi.
  - Ogretmen yardimcisini suclu gostermek icin sahte iz birakti.
  timelineOptions:
  - Once kantinden enerji icecegi aldi, sonra laboratuvar koridoruna girdi, arsiv
    kayitlarini kontrol etti ve ogretmenler odasindaki dolabi acmak icin yedek anahtari
    kullandi.
  - Once kantinden enerji icecegi aldi, sonra dogrudan kutuphaneye gidip notu orada
    sakladi.
  - Ogretmenler odasindaki dolabi acti, ardindan guvenlik odasinda kamera kaydini
    degistirdi.
